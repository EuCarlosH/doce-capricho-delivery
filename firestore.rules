rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Clientes criam pedidos e consultam um pedido pelo ID exato.
    // O painel autenticado pode listar, atualizar e excluir pedidos.
    match /pedidos/{pedido} {
      allow create: if request.resource.data.status == 'Novo'
                    && request.resource.data.total_centavos is int
                    && request.resource.data.total_centavos >= 0
                    && request.resource.data.cliente_nome is string
                    && request.resource.data.cliente_nome.size() > 0;

      allow get: if true;
      allow list: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Contadores utilizados pelo selo "Mais Pedida".
    match /configuracoes/estatisticas {
      allow read: if true;
      allow write: if true;
    }

    // Configurações públicas da loja; somente o painel autenticado grava.
    match /configuracoes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // O cliente consulta somente o hash exato do cupom digitado.
    // Apenas o painel autenticado lista e administra cupons.
    match /cupons/{cupomHash} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
